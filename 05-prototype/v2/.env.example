# Sao chép file này thành .env rồi điền khóa. KHÔNG đưa .env lên Git hay gửi cho ai.
GEMINI_API_KEY=
# Mô hình (theo trang tài liệu Gemini API ngày 20/10/2026: gemini-3.8-flash là Flash mới nhất;
# gemini-3.5-flash-lite rẻ và nhanh hơn). Đổi nếu mô hình không còn dùng được.
GEMINI_MODEL=gemini-3.8-flash
# Giới hạn số lần gọi mô hình mỗi lần chạy server (khống chế chi phí). Hết lượt sẽ tự về chế độ mô phỏng.
MAX_CALLS=200
PORT=3000
